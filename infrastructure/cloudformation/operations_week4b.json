{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Retail forecasting monitoring, SNS alerting, and disabled EventBridge demo schedule.",
  "Parameters": {
    "DeploymentRevision": {
      "Type": "String",
      "Default": "local",
      "AllowedPattern": "[A-Za-z0-9._-]+"
    }
  },
  "Resources": {
    "AlertsTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "retail-forecast-operations-alerts"
      }
    },
    "TopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "AlertsTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AccountAdministration",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": [
                "sns:GetTopicAttributes",
                "sns:SetTopicAttributes",
                "sns:AddPermission",
                "sns:RemovePermission",
                "sns:DeleteTopic",
                "sns:Subscribe",
                "sns:ListSubscriptionsByTopic",
                "sns:Publish"
              ],
              "Resource": {
                "Ref": "AlertsTopic"
              }
            },
            {
              "Sid": "CloudWatchAlarmNotifications",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "AlertsTopic"
              },
              "Condition": {
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:retail-forecast-*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "V1ExecutionsFailed": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "retail-forecast-v1-executionsfailed",
        "AlarmDescription": "retail-v1-forecast-workflow: ExecutionsFailed detected",
        "Namespace": "AWS/States",
        "MetricName": "ExecutionsFailed",
        "Dimensions": [
          {
            "Name": "StateMachineArn",
            "Value": {
              "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v1-forecast-workflow"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlertsTopic"
          }
        ]
      }
    },
    "V1ExecutionsTimedOut": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "retail-forecast-v1-executionstimedout",
        "AlarmDescription": "retail-v1-forecast-workflow: ExecutionsTimedOut detected",
        "Namespace": "AWS/States",
        "MetricName": "ExecutionsTimedOut",
        "Dimensions": [
          {
            "Name": "StateMachineArn",
            "Value": {
              "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v1-forecast-workflow"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlertsTopic"
          }
        ]
      }
    },
    "V1ExecutionsAborted": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "retail-forecast-v1-executionsaborted",
        "AlarmDescription": "retail-v1-forecast-workflow: ExecutionsAborted detected",
        "Namespace": "AWS/States",
        "MetricName": "ExecutionsAborted",
        "Dimensions": [
          {
            "Name": "StateMachineArn",
            "Value": {
              "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v1-forecast-workflow"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlertsTopic"
          }
        ]
      }
    },
    "V2ExecutionsFailed": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "retail-forecast-v2-executionsfailed",
        "AlarmDescription": "retail-v2-test-forecast-workflow: ExecutionsFailed detected",
        "Namespace": "AWS/States",
        "MetricName": "ExecutionsFailed",
        "Dimensions": [
          {
            "Name": "StateMachineArn",
            "Value": {
              "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlertsTopic"
          }
        ]
      }
    },
    "V2ExecutionsTimedOut": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "retail-forecast-v2-executionstimedout",
        "AlarmDescription": "retail-v2-test-forecast-workflow: ExecutionsTimedOut detected",
        "Namespace": "AWS/States",
        "MetricName": "ExecutionsTimedOut",
        "Dimensions": [
          {
            "Name": "StateMachineArn",
            "Value": {
              "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlertsTopic"
          }
        ]
      }
    },
    "V2ExecutionsAborted": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "retail-forecast-v2-executionsaborted",
        "AlarmDescription": "retail-v2-test-forecast-workflow: ExecutionsAborted detected",
        "Namespace": "AWS/States",
        "MetricName": "ExecutionsAborted",
        "Dimensions": [
          {
            "Name": "StateMachineArn",
            "Value": {
              "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlertsTopic"
          }
        ]
      }
    },
    "MonitoringDashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": "RetailForecast-Week4B-Operations",
        "DashboardBody": {
          "Fn::Sub": "{\"widgets\": [{\"type\": \"metric\", \"x\": 0, \"y\": 0, \"width\": 12, \"height\": 7, \"properties\": {\"title\": \"V1 \\u2014 retail-v1-forecast-workflow\", \"view\": \"timeSeries\", \"region\": \"${AWS::Region}\", \"stat\": \"Sum\", \"period\": 300, \"metrics\": [[\"AWS/States\", \"ExecutionsStarted\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v1-forecast-workflow\", {\"label\": \"ExecutionsStarted\"}], [\"AWS/States\", \"ExecutionsSucceeded\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v1-forecast-workflow\", {\"label\": \"ExecutionsSucceeded\"}], [\"AWS/States\", \"ExecutionsFailed\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v1-forecast-workflow\", {\"label\": \"ExecutionsFailed\"}], [\"AWS/States\", \"ExecutionsTimedOut\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v1-forecast-workflow\", {\"label\": \"ExecutionsTimedOut\"}], [\"AWS/States\", \"ExecutionsAborted\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v1-forecast-workflow\", {\"label\": \"ExecutionsAborted\"}]]}}, {\"type\": \"metric\", \"x\": 12, \"y\": 0, \"width\": 12, \"height\": 7, \"properties\": {\"title\": \"V2 \\u2014 retail-v2-test-forecast-workflow\", \"view\": \"timeSeries\", \"region\": \"${AWS::Region}\", \"stat\": \"Sum\", \"period\": 300, \"metrics\": [[\"AWS/States\", \"ExecutionsStarted\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow\", {\"label\": \"ExecutionsStarted\"}], [\"AWS/States\", \"ExecutionsSucceeded\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow\", {\"label\": \"ExecutionsSucceeded\"}], [\"AWS/States\", \"ExecutionsFailed\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow\", {\"label\": \"ExecutionsFailed\"}], [\"AWS/States\", \"ExecutionsTimedOut\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow\", {\"label\": \"ExecutionsTimedOut\"}], [\"AWS/States\", \"ExecutionsAborted\", \"StateMachineArn\", \"arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow\", {\"label\": \"ExecutionsAborted\"}]]}}, {\"type\": \"text\", \"x\": 0, \"y\": 7, \"width\": 24, \"height\": 2, \"properties\": {\"markdown\": \"**Deployed Git revision:** `${DeploymentRevision}`\"}}]}"
        }
      }
    },
    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "RetailForecastWeek4BSchedulerRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "StartV2Only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "states:StartExecution",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DisabledSchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": "retail-v2-demo-daily-disabled",
        "Description": "Historical 2017 data: do not enable without a fresh data source",
        "State": "DISABLED",
        "ScheduleExpression": "cron(0 5 * * ? *)",
        "ScheduleExpressionTimezone": "Etc/UTC",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:retail-v2-test-forecast-workflow"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "Input": "{\"run_id\": \"<aws.scheduler.execution-id>\"}"
        }
      }
    }
  },
  "Outputs": {
    "DeploymentRevision": {
      "Value": {
        "Ref": "DeploymentRevision"
      }
    },
    "AlertsTopicArn": {
      "Value": {
        "Ref": "AlertsTopic"
      }
    },
    "DashboardName": {
      "Value": "RetailForecast-Week4B-Operations"
    },
    "SchedulingStatus": {
      "Value": "DISABLED"
    }
  }
}
