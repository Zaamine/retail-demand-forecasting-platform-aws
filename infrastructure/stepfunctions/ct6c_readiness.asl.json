{
  "Comment": "CT-6C: checkpoint-aware gate; READY always blocked until dynamic CT2-CT5 is implemented; EventBridge OFF",
  "StartAt": "AcquireGlobalLock",
  "TimeoutSeconds": 2400,
  "States": {
    "AcquireGlobalLock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "RetailForecastCT6CExecutionLock",
        "Item": {
          "LockName": {
            "S": "ct-global-exclusive"
          },
          "Owner": {
            "S.$": "$$.Execution.Id"
          },
          "CreatedAt": {
            "S.$": "$$.State.EnteredTime"
          }
        },
        "ConditionExpression": "attribute_not_exists(LockName)"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException"
          ],
          "ResultPath": "$.lock_error",
          "Next": "ConcurrentExecutionBlocked"
        }
      ],
      "Next": "CreateUniqueJobName"
    },
    "ConcurrentExecutionBlocked": {
      "Type": "Pass",
      "Parameters": {
        "status": "BLOCKED",
        "reason": "GLOBAL_CT_LOCK_ALREADY_HELD"
      },
      "End": true
    },
    "CreateUniqueJobName": {
      "Type": "Pass",
      "Parameters": {
        "job_name.$": "States.Format('ct-gate-{}', States.UUID())"
      },
      "ResultPath": "$.run",
      "Next": "VerifyGlueSource"
    },
    "VerifyGlueSource": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getTable",
      "Parameters": {
        "DatabaseName": "retail_demand_forecasting_curated",
        "Name": "stg_sales"
      },
      "ResultPath": "$.catalog",
      "Next": "VerifyGlueLocation"
    },
    "VerifyGlueLocation": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.catalog.Table.StorageDescriptor.Location",
          "StringEquals": "s3://retail-demand-forecasting-platform-aws-zaamine/curated/stg_sales/",
          "Next": "ReadCheckpointAndCuratedSales"
        },
        {
          "Variable": "$.catalog.Table.StorageDescriptor.Location",
          "StringEquals": "s3://retail-demand-forecasting-platform-aws-zaamine/curated/stg_sales",
          "Next": "ReadCheckpointAndCuratedSales"
        }
      ],
      "Default": "UnexpectedGlueSourceFailClosed"
    },
    "UnexpectedGlueSourceFailClosed": {
      "Type": "Fail",
      "Error": "GlueSourceDrift",
      "Cause": "Glue source location changed; lock retained for investigation"
    },
    "ReadCheckpointAndCuratedSales": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "$.run.job_name",
        "RoleArn": "arn:aws:iam::634512762949:role/RetailForecastSageMakerExecutionRole",
        "AppSpecification": {
          "ImageUri": "634512762949.dkr.ecr.eu-west-1.amazonaws.com/retail-forecast-xgboost-batch@sha256:9eac3c07454a44e1c2a2fd0844cb86aeae5b83036dc37f2e81bab31a59dd06d7",
          "ContainerEntrypoint": [
            "python",
            "-u",
            "/opt/ml/processing/input/code/ct_workflow_readiness.py"
          ],
          "ContainerArguments": [
            "--config",
            "/opt/ml/processing/input/code/ct_orchestration_v1.json",
            "--output-dir",
            "/opt/ml/processing/output"
          ]
        },
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/continuous_training/v1/orchestration/code/8f60ce5e6be3ab014a9f75d5/",
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          },
          {
            "InputName": "checkpoint",
            "S3Input": {
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/continuous_training/v1/state/last_successful_ct.json",
              "LocalPath": "/opt/ml/processing/input/checkpoint",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          },
          {
            "InputName": "sales",
            "S3Input": {
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/curated/stg_sales/",
              "LocalPath": "/opt/ml/processing/input/sales",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "readiness",
              "S3Output": {
                "S3Uri.$": "States.Format('s3://retail-demand-forecasting-platform-aws-zaamine/mlops/continuous_training/v1/orchestration/outputs/{}/', $.run.job_name)",
                "LocalPath": "/opt/ml/processing/output",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "ml.t3.xlarge",
            "VolumeSizeInGB": 20
          }
        },
        "StoppingCondition": {
          "MaxRuntimeInSeconds": 900
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "retail-demand-forecasting"
          },
          {
            "Key": "Stage",
            "Value": "ct-checkpoint-readiness"
          }
        ]
      },
      "ResultPath": "$.job",
      "TimeoutSeconds": 1800,
      "Next": "ReadS3ReadinessReport"
    },
    "ReadS3ReadinessReport": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket": "retail-demand-forecasting-platform-aws-zaamine",
        "Key.$": "States.Format('mlops/continuous_training/v1/orchestration/outputs/{}/readiness_report.json', $.run.job_name)"
      },
      "ResultSelector": {
        "result.$": "States.StringToJson($.Body)"
      },
      "ResultPath": "$.readiness",
      "Next": "ReadLiveCheckpoint"
    },
    "ReadLiveCheckpoint": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket": "retail-demand-forecasting-platform-aws-zaamine",
        "Key": "mlops/continuous_training/v1/state/last_successful_ct.json"
      },
      "ResultSelector": {
        "sha256.$": "States.Hash($.Body, 'SHA-256')"
      },
      "ResultPath": "$.live_checkpoint",
      "Next": "CheckpointStillCurrent"
    },
    "CheckpointStillCurrent": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.live_checkpoint.sha256",
          "StringEqualsPath": "$.readiness.result.checkpoint_sha256",
          "Next": "RouteReadinessStatus"
        }
      ],
      "Default": "ChangedCheckpointFailClosed"
    },
    "ChangedCheckpointFailClosed": {
      "Type": "Fail",
      "Error": "CheckpointChanged",
      "Cause": "Checkpoint updated during workflow; lock retained"
    },
    "RouteReadinessStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.readiness.result.status",
          "StringEquals": "SKIPPED",
          "Next": "OutcomeSkipped"
        },
        {
          "Variable": "$.readiness.result.status",
          "StringEquals": "BLOCKED",
          "Next": "OutcomeBlocked"
        },
        {
          "Variable": "$.readiness.result.status",
          "StringEquals": "READY",
          "Next": "OutcomeReadyBlocked"
        }
      ],
      "Default": "UnexpectedReportFailClosed"
    },
    "OutcomeSkipped": {
      "Type": "Pass",
      "Parameters": {
        "status": "SKIPPED",
        "reason.$": "$.readiness.result.reason",
        "checkpoint_cutoff.$": "$.readiness.result.checkpoint_cutoff",
        "next_required_labeled_end.$": "$.readiness.result.next_required_labeled_end",
        "processing_job.$": "$.run.job_name"
      },
      "ResultPath": "$.outcome",
      "Next": "ReleaseGlobalLock"
    },
    "OutcomeBlocked": {
      "Type": "Pass",
      "Parameters": {
        "status": "BLOCKED",
        "reason.$": "$.readiness.result.reason",
        "processing_job.$": "$.run.job_name"
      },
      "ResultPath": "$.outcome",
      "Next": "ReleaseGlobalLock"
    },
    "OutcomeReadyBlocked": {
      "Type": "Pass",
      "Parameters": {
        "status": "BLOCKED",
        "reason": "READY_DATA_BUT_DYNAMIC_CT2_CT5_NOT_YET_CONFIGURED",
        "next_training_cutoff.$": "$.readiness.result.next_training_cutoff",
        "processing_job.$": "$.run.job_name"
      },
      "ResultPath": "$.outcome",
      "Next": "ReleaseGlobalLock"
    },
    "UnexpectedReportFailClosed": {
      "Type": "Fail",
      "Error": "InvalidReadinessStatus",
      "Cause": "Unknown status. Global lock deliberately retained for investigation."
    },
    "ReleaseGlobalLock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName": "RetailForecastCT6CExecutionLock",
        "Key": {
          "LockName": {
            "S": "ct-global-exclusive"
          }
        },
        "ConditionExpression": "#owner = :owner",
        "ExpressionAttributeNames": {
          "#owner": "Owner"
        },
        "ExpressionAttributeValues": {
          ":owner": {
            "S.$": "$$.Execution.Id"
          }
        }
      },
      "ResultPath": null,
      "Next": "ReturnOutcome"
    },
    "ReturnOutcome": {
      "Type": "Pass",
      "OutputPath": "$.outcome",
      "End": true
    }
  }
}
