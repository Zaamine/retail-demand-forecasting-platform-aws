# Lightweight, reproducible container for forecasting CI tests.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/src

WORKDIR /app

# boto3 installs the compatible botocore dependency.
RUN python -m pip install --no-cache-dir \
    numpy==2.5.3 \
    pandas==3.0.6 \
    boto3==1.43.113 \
    pytest==9.2.0 \
    scikit-learn==1.9.1 \
    mcp==2.3.0

# Reusable code, AWS scripts, and automated tests.
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY pipelines/ ./pipelines/
COPY tests/ ./tests/

# Frozen V1 configuration required by the tests.
COPY configs/global_xgboost/categories_v1.json \
     ./configs/global_xgboost/categories_v1.json

# CT tests import these frozen JSON configurations.
COPY configs/sagemaker/ct_*.json ./configs/sagemaker/

COPY artifacts/global_xgboost/point_forecast_model_contract_v1.json \
     ./artifacts/global_xgboost/point_forecast_model_contract_v1.json

CMD ["python", "-m", "pytest", "tests", "-q"]

# Curated knowledge needed by agent and retrieval tests.
COPY docs/knowledge/ ./docs/knowledge/

# Frozen evaluation evidence needed by knowledge facts tests.
COPY docs/assets/global_forecasting/final_holdout_historical_context.csv \
     ./docs/assets/global_forecasting/final_holdout_historical_context.csv

COPY artifacts/aws/sagemaker_registry/champion_v1/evaluation_report_cloud.json \
     ./artifacts/aws/sagemaker_registry/champion_v1/evaluation_report_cloud.json
