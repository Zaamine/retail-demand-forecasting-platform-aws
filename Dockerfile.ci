# Lightweight, reproducible container for forecasting CI tests.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/src

WORKDIR /app

# boto3 installs the compatible botocore dependency.
RUN python -m pip install --no-cache-dir \
    numpy==2.5.3 \
    pandas==3.0.6 \
    boto3==1.40.0

# Reusable code, AWS scripts, and automated tests.
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY pipelines/ ./pipelines/
COPY tests/ ./tests/

# Frozen V1 configuration required by the tests.
COPY configs/global_xgboost/categories_v1.json \
     ./configs/global_xgboost/categories_v1.json

COPY artifacts/global_xgboost/point_forecast_model_contract_v1.json \
     ./artifacts/global_xgboost/point_forecast_model_contract_v1.json

CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
