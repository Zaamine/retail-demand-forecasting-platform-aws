# Deny everything by default.
*

# Forecasting source code.
!src/
!src/**

# AWS MLOps scripts and processing pipelines.
!scripts/
!scripts/**
!pipelines/
!pipelines/**

# Automated tests.
!tests/
!tests/**

# Frozen categorical vocabulary.
!configs/
configs/*
!configs/global_xgboost/
configs/global_xgboost/*
!configs/global_xgboost/categories_v1.json

# Lightweight model contract only.
!artifacts/
artifacts/*
!artifacts/global_xgboost/
artifacts/global_xgboost/*
!artifacts/global_xgboost/point_forecast_model_contract_v1.json

# Exclude generated files.
**/__pycache__/
**/*.pyc
**/.DS_Store
