# Deny everything by default.
*

# Forecasting source code.
!src/
!src/**

# AWS MLOps scripts and processing pipelines.
!scripts/
!scripts/**
!pipelines/
!pipelines/**

# Automated tests.
!tests/
!tests/**

# Frozen categorical vocabulary.
!configs/
configs/*
!configs/global_xgboost/
configs/global_xgboost/*
!configs/global_xgboost/categories_v1.json

# Include only the CT configs required by the integration tests.
!configs/sagemaker/
configs/sagemaker/*
!configs/sagemaker/ct_*.json

# Lightweight model contract only.
!artifacts/
artifacts/*
!artifacts/global_xgboost/
artifacts/global_xgboost/*
!artifacts/global_xgboost/point_forecast_model_contract_v1.json

# Exclude generated files.
**/__pycache__/
**/*.pyc
**/.DS_Store

# Curated knowledge, without copying unrelated documents.
!docs/
docs/*
!docs/knowledge/
docs/knowledge/*
!docs/knowledge/*.md
!docs/assets/
docs/assets/*
!docs/assets/global_forecasting/
docs/assets/global_forecasting/*
!docs/assets/global_forecasting/final_holdout_historical_context.csv

# Include only the frozen cloud evaluation JSON.
!artifacts/aws/
artifacts/aws/*
!artifacts/aws/sagemaker_registry/
artifacts/aws/sagemaker_registry/*
!artifacts/aws/sagemaker_registry/champion_v1/
artifacts/aws/sagemaker_registry/champion_v1/*
!artifacts/aws/sagemaker_registry/champion_v1/evaluation_report_cloud.json
