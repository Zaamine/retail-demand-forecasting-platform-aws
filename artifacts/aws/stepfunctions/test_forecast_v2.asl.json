{
  "Comment": "Unlabeled test forecasting with frozen champion V1",
  "StartAt": "BuildOutOfSampleFeatures",
  "TimeoutSeconds": 3600,
  "States": {
    "BuildOutOfSampleFeatures": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('retail-v2-feat-{}', $.run_id)",
        "RoleArn": "arn:aws:iam::634512762949:role/RetailForecastSageMakerExecutionRole",
        "AppSpecification": {
          "ImageUri": "634512762949.dkr.ecr.eu-west-1.amazonaws.com/retail-forecast-xgboost-batch@sha256:9eac3c07454a44e1c2a2fd0844cb86aeae5b83036dc37f2e81bab31a59dd06d7",
          "ContainerEntrypoint": [
            "python",
            "/opt/ml/processing/input/code/build_test_features.py"
          ]
        },
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/inputs/77004cc10a375e60bc21cd14/code/"
            }
          },
          {
            "InputName": "contract",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/contract",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/inputs/77004cc10a375e60bc21cd14/code/contract/point_forecast_model_contract_v1.json"
            }
          },
          {
            "InputName": "categories",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/categories",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/inputs/77004cc10a375e60bc21cd14/code/categories/categories_v1.json"
            }
          },
          {
            "InputName": "test",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/test",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/inputs/77004cc10a375e60bc21cd14/code/test/test.csv"
            }
          },
          {
            "InputName": "sales",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/sales",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/curated/stg_sales/"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "feat",
              "S3Output": {
                "LocalPath": "/opt/ml/processing/output",
                "S3UploadMode": "EndOfJob",
                "S3Uri.$": "States.Format('s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/features/{}/', $.run_id)"
              }
            }
          ]
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "ml.t3.xlarge",
            "VolumeSizeInGB": 10
          }
        },
        "StoppingCondition": {
          "MaxRuntimeInSeconds": 900
        }
      },
      "ResultPath": "$.feature_result",
      "Next": "GenerateAndValidateTestForecasts"
    },
    "GenerateAndValidateTestForecasts": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('retail-v2-pred-{}', $.run_id)",
        "RoleArn": "arn:aws:iam::634512762949:role/RetailForecastSageMakerExecutionRole",
        "AppSpecification": {
          "ImageUri": "634512762949.dkr.ecr.eu-west-1.amazonaws.com/retail-forecast-xgboost-batch@sha256:9eac3c07454a44e1c2a2fd0844cb86aeae5b83036dc37f2e81bab31a59dd06d7",
          "ContainerEntrypoint": [
            "python",
            "/opt/ml/processing/input/code/predict_test.py"
          ]
        },
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/inputs/77004cc10a375e60bc21cd14/code/"
            }
          },
          {
            "InputName": "contract",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/contract",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/inputs/77004cc10a375e60bc21cd14/code/contract/point_forecast_model_contract_v1.json"
            }
          },
          {
            "InputName": "categories",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/categories",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/inputs/77004cc10a375e60bc21cd14/code/categories/categories_v1.json"
            }
          },
          {
            "InputName": "test",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/test",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/inputs/77004cc10a375e60bc21cd14/code/test/test.csv"
            }
          },
          {
            "InputName": "model",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/model",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://retail-demand-forecasting-platform-aws-zaamine/artifacts/global_xgboost/v1/model.tar.gz"
            }
          },
          {
            "InputName": "features",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/features",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri.$": "States.Format('s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/features/{}/features.parquet', $.run_id)"
            }
          },
          {
            "InputName": "manifest",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/manifest",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri.$": "States.Format('s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/features/{}/features.manifest.json', $.run_id)"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "pred",
              "S3Output": {
                "LocalPath": "/opt/ml/processing/output",
                "S3UploadMode": "EndOfJob",
                "S3Uri.$": "States.Format('s3://retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/predictions/{}/', $.run_id)"
              }
            }
          ]
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "ml.t3.medium",
            "VolumeSizeInGB": 10
          }
        },
        "StoppingCondition": {
          "MaxRuntimeInSeconds": 900
        }
      },
      "ResultPath": "$.prediction_result",
      "Next": "PublishUnlabeledForecasts"
    },
    "PublishUnlabeledForecasts": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:copyObject",
      "Parameters": {
        "Bucket": "retail-demand-forecasting-platform-aws-zaamine",
        "CopySource.$": "States.Format('retail-demand-forecasting-platform-aws-zaamine/mlops/test_forecast/v2/predictions/{}/forecast_predictions.parquet', $.run_id)",
        "Key.$": "States.Format('forecasts/published/v2/origin=2017-08-15/{}/forecast_predictions.parquet', $.run_id)"
      },
      "End": true
    }
  }
}
